# 复制为 .env.local / .env.development 后按需修改
# 后端 API 前缀（与 src/api/request.ts 的 baseURL 一致）
VITE_API_BASE_URL=/api/v1
# 是否启用开发期 MSW mock：
#   false = 直连真实后端（项目默认；需启动 backend，Vite 会代理 /api 到 127.0.0.1:8000）
#   true  = 前端独立演示，不启动后端也能跑通全部界面（真实后端 M1～M7 已实现）
# 仅 DEV 生效；生产构建永远不会打包 msw 与 mockServiceWorker.js
VITE_USE_MOCK=false
