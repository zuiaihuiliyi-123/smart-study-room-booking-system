@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #475569
skinparam classHeaderBackgroundColor #F1F5F9
skinparam enumBackgroundColor #FFF7ED
skinparam enumBorderColor #F97316
skinparam noteBackgroundColor #FFFDF0
skinparam noteBorderColor #FDE68A
skinparam noteFontColor #78350F
skinparam arrowColor #64748B
skinparam arrowFontColor #475569
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80

title 智慧自习室预约与管理系统 · 领域类图\n依据需求规格说明书 V0.3 第 4.7.1 节 · 全部内容未经走查与验证

' ==================== 枚举 ====================
enum "SeatStatus\n座位资源状态" as SeatStatus {
  可用
  维修中
  停用
}

enum "ReservationStatus\n预约状态" as ReservationStatus {
  待使用
  使用中
  已完成
  已取消
  已违约
}

enum "AccountStatus\n账户状态" as AccountStatus {
  正常
  受限
  停用
}

enum "ComplaintStatus\n投诉状态" as ComplaintStatus {
  待处理
  处理中
  已处理
  已驳回
  已关闭
}

enum "Role\n用户角色" as Role {
  R-01 学生用户
  R-02 自习室管理员
  R-03 教师用户
  R-04 系统管理员
}

enum "ViolationType\n违约类型" as ViolationType {
  自动违约
  手动违约登记
}

' ==================== 类 ====================
class "CL-02 Room 自习室" as CL02 <<DR-002>> {
  - roomId : String {PK}
  - name : String
  - location : String
  - openTime : String
  - capacity : Integer
  - enabled : Boolean
  + maintain() : FR-001
}

class "CL-03 Area 分区" as CL03 <<DR-003 / AS-05>> {
  - areaId : String {PK}
  - name : String
  - note : String
}

class "CL-04 Seat 座位" as CL04 <<DR-003>> {
  - seatId : String {PK}
  - seatNo : String
  - seatType : String
  - hasPower : Boolean
  - status : SeatStatus
  + changeStatus() : FR-004
}

class "CL-05 Reservation 预约单" as CL05 <<DR-004>> {
  - reservationId : String {PK}
  - reserveDate : Date
  - startTime : Time {s}
  - endTime : Time {e}
  - status : ReservationStatus
  - checkInTime : Time
  - checkOutTime : Time
  - cancelTime : Time
  - cancelReason : String
  - idempotencyKey : String
  + validateRules() : FR-012
  + verifyConflict() : BR-005 / BR-006
  + isActive() : TM-18 有效预约
}

class "CL-01 User 用户" as CL01 <<DR-001>> {
  - userId : String {PK}
  - name : String
  - studentNo : String {UNIQUE}
  - role : Role
  - accountStatus : AccountStatus
  - violationCount : Integer
  - contact : String
  + createReservation() : FR-010
  + cancelReservation() : FR-011
  + checkIn() : FR-020
  + checkOut() : FR-021
}

class "CL-08 Complaint 投诉" as CL08 <<DR-007>> {
  - complaintId : String {PK}
  - targetType : String
  - targetId : String
  - content : String
  - status : ComplaintStatus
  - handleNote : String
  - handleTime : Time
  - operatorId : String
}

class "CL-09 BlacklistEntry 黑名单记录" as CL09 <<DR-008>> {
  - entryId : String {PK}
  - joinReason : String
  - joinMode : String
  - joinTime : Time
  - limitUntil : Time
  - releaseTime : Time
  - operatorId : String
}

class "CL-10 AuditLog 审计日志" as CL10 <<DR-009>> {
  - logId : String {PK}
  - operatorId : String
  - actionType : String
  - targetObject : String
  - actionTime : Time
  - reason : String
  - beforeValue : String
  - afterValue : String
}

class "CL-06 ViolationRecord 违约记录" as CL06 <<DR-005>> {
  - violationId : String {PK}
  - violationType : ViolationType
  - violationTime : Time
  - reason : String
  - operatorId : String
}

class "CL-07 Review 评价" as CL07 <<DR-006>> {
  - reviewId : String {PK}
  - score : Integer
  - content : String
  - submitTime : Time
}

' ==================== 关系 ====================
CL02 "1" *-- "*" CL03 : 包含
CL02 "1" *-- "*" CL04 : 包含
CL03 "1" *-- "*" CL04 : 包含

CL04 "1" -- "*" CL05 : 被预约
CL01 "1" -- "*" CL05 : 发起

CL05 "1" -- "*" CL06 : 产生
CL01 "1" -- "*" CL06 : 承担
CL05 "1" -- "*" CL07 : 评价

CL01 "1" -- "*" CL08 : 提交
CL01 "1" -- "*" CL08 : 被投诉
CL01 "1" -- "*" CL09 : 受限
CL09 "*" -- "*" CL10 : 产生操作

' ==================== 注释 ====================
note bottom of CL02
  BR-017 资源状态为「维修中」或「停用」时不可被预约。
  BR-019 存在未有效预约时设置维修/停用，处置方式【未确认】（ST-006 / ST-033）。
end note

note bottom of CL05
  关键约束（AI 候选，待确认）
  BR-020 占用区间为左闭右开 [s, e)。
  BR-005 同一用户同一时段不得有两条有效预约。
  BR-006 同一座位同一时段不得有两条有效预约。
  BR-001 时段对齐粒度（候选 30 分钟）。
  BR-002 提前预约不超过 N 天（候选 7 天）。
  BR-003 单次时长不超过 M 小时（候选 4 小时）。
  BR-004 每日预约次数不超过 K 条（候选 2 条）。
end note

note bottom of CL09
  BR-009 累计违约达 T 次自动受限（候选 3 次）。
  BR-010 限制期 P 天（候选 7 天）。
  受限期间不可创建预约（ST-047，状态保持）。
  【待确认】账户转为受限/停用后，已有关联预约如何处理（ST-049）——未定义。
end note

note as N1
  【V0.3 状态模型重建设明】
  座位不再有「已预约」「使用中」状态，以下转换已从本模型删除：
  原 ST-001 座位空闲 → 已预约   原 ST-002 座位已预约 → 使用中
  原 ST-003 座位已预约 → 空闲   原 ST-004 座位已预约 → 违约（自动违约）
  原 ST-005 座位使用中 → 空闲   原 ST-006 座位使用中 → 违约
  原文对应第 10.2.5 节。
end note

note as N2
  【未展开的关联】
  1. 原 CF-04（座位状态与预约单状态不一致为谁为准）已在 V0.3 澄清：座位不再存储占用状态，
     预约单是占用关系的唯一权威数据源（原文第 10.4.2 节）。原表述第 1 条作废。
  2. 违约记录被撤销（FR-024）后，累计违约次数是否回退，尚未定义。
  【NFR-009】 管理员关键操作须留痕：座位状态调整、手动违约登记、黑名单变更、投诉处理。
  日志只允许追加，不可修改或删除。
end note

@enduml