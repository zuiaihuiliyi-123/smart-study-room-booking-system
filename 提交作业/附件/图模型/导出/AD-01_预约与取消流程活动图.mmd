flowchart TD
    A(["开始"]) --> B["学生用户选择自习室与目标时段 [s, e)"]
    B --> C["系统按第 4.4.2 节计算可预约性 C1～C6"]
    C --> D{"C5 账户状态是否为正常"}
    D -- 否 --> E["拒绝并提示限制原因与预计解除时间 ST-047"]
    D -- 是 --> F{"C1/C2 座位资源是否为可用且在开放时间内"}
    F -- 否 --> G["该座位不可预约 BR-017，返回其他候选座位"]
    F -- 是 --> H{"C6 是否满足 BR-001～BR-004"}
    H -- 否 --> I["拒绝并提示未通过的具体规则项与参数 ST-028"]
    H -- 是 --> J{"C3/C4 该用户与该座位在 [s,e) 内是否已有有效预约"}
    J -- 是 --> K["拒绝并提示时段冲突 ST-028"]
    J -- 否 --> L["提交预约请求（携带幂等键）"]
    L --> M{"并发写入是否冲突 ST-035"}
    M -- 是 --> N["返回该时段已被占用"]
    M -- 否 --> O["创建预约单 状态=待使用"]
    O --> P["写入审计日志；**不改变座位资源状态**"]
    P --> Q{"用户或管理员是否取消"}
    Q -- 是 --> R{"用户取消：提交时刻是否早于 s − C 分钟 BR-011"}
    R -- 否 --> S["拒绝取消并提示 ST-029"]
    R -- 是 --> T["预约单 待使用→已取消 ST-021"]
    Q -- 管理员强制取消 ST-022 --> T
    T --> V["该时段按 C3 重新可预约（无需改变座位状态）"]
    Q -- 否 --> W(["等待签到"])
    V --> X(["结束"])
    S --> W
    W --> X
    G --> X
    I --> X
    K --> X
    N --> X
    E --> X

