flowchart TD
    A(["进入预约时段"]) --> B{"当前时间是否在签到窗口 [s−X, s+Y) 内 BR-007"}
    B -- 早于窗口 --> C["提示签到尚未开放"]
    C --> B
    B -- 是 --> D["用户提交签到"]
    D --> E{"预约单是否属于本人，且状态为待使用"}
    E -- 否 --> F["拒绝签到并提示 ST-027"]
    E -- 已处于使用中 --> F2["拒绝重复签到（幂等）ST-030"]
    E -- 已处于终态 --> F3["拒绝并提示该预约已结束 ST-031"]
    E -- 是 --> G["预约单 待使用→使用中 ST-020"]
    G --> H["记录签到时间"]
    H --> I{"用户是否主动签退"}
    I -- 是 --> J{"预约单状态是否为使用中"}
    J -- 是 --> K["预约单 使用中→已完成 ST-024"]
    J -- 否 --> L["拒绝签退并提示 ST-031"]
    I -- 否 --> M{"是否到达预约结束时间 e"}
    M -- 否 --> I
    M -- 是 --> N["系统自动结束 预约单→已完成 ST-025"]
    B -- 超过 s+Y 仍未签到 --> O["系统自动违约 ST-023"]
    O --> P["生成违约记录；用户累计有效违约次数 +1"]
    P --> P2{"同一预约单是否已被处理过 ST-034"}
    P2 -- 是 --> P3["幂等：不重复生成记录、不重复累加"]
    P2 -- 否 --> Q{"累计有效违约是否达到阈值 BR-009"}
    P3 --> R(["结束"])
    Q -- 是 --> S["用户账户 正常→受限 ST-040"]
    Q -- 否 --> R
    S --> R
    K --> R
    N --> R
    L --> R
    F --> R
    F2 --> R
    F3 --> R

