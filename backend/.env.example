APP_NAME=智慧自习室预约与管理系统
DEBUG=true

# MySQL 8.4 LTS：先执行 scripts/init_db.sql 创建库和 study_app 账号
# 不要使用 root 运行应用；CHANGE_ME_APP_PASSWORD 换成你自己的密码
# 密码含 @ : / ? # 等字符时需 URL 编码，建议用 openssl rand -hex 16 生成
DATABASE_URL=mysql+pymysql://study_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:3306/smart_study_room?charset=utf8mb4

# 必须替换为一个足够长的随机字符串（≥32 字节，建议 openssl rand -hex 32）。
# 应用启动时会校验：仍为占位符或长度不足将拒绝启动（§2.1 不得绕过身份认证）。
JWT_SECRET_KEY=replace-with-a-long-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# 学生自助注册策略（A2）：
#   REGISTRATION_ENABLED=false 时关闭自助注册，由管理员批量开户
#   REGISTRATION_WHITELIST 为可选的学籍白名单（逗号分隔）；留空表示不限制
#   适合小规模名单；真实上线建议改为数据库 / 学籍系统同步
#   课程演示默认：开放注册、不限制学号
REGISTRATION_ENABLED=true
REGISTRATION_WHITELIST=

# 登录失败锁定（B5）：窗口内连续失败达到上限后临时锁定。
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# ---- 数据库连接池 / 并发重试（生产 MySQL） ----
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=3600
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=50

# ---- 统一时间口径（MySQL DATETIME 存该时区的墙上时间） ----
APP_TIMEZONE=Asia/Shanghai

# ---- 看板短缓存与调度任务 ----
DASHBOARD_CACHE_SECONDS=10
SCHEDULER_MISFIRE_GRACE_SECONDS=60
SCHEDULER_TASK_RETRIES=2
SCHEDULER_RETRY_DELAY_SECONDS=5
