APP_NAME=智慧自习室预约与管理系统
DEBUG=true

# MySQL 8.4：请先创建数据库 smart_study_room（utf8mb4）
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/smart_study_room?charset=utf8mb4

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# 定时任务（测试环境建议 false）
SCHEDULER_ENABLED=true

# ---- 业务参数（与需求说明书本版取值一致） ----
RESERVATION_GRANULARITY_MINUTES=30
ADVANCE_BOOKING_DAYS=7
MAX_RESERVATION_HOURS=4
DAILY_RESERVATION_LIMIT=2
CHECKIN_EARLY_MINUTES=15
CHECKIN_LATE_MINUTES=15
CANCEL_BEFORE_MINUTES=30
VIOLATION_THRESHOLD=3
RESTRICTION_DAYS=7
DASHBOARD_REFRESH_SECONDS=10
