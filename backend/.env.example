APP_NAME=智慧自习室预约与管理系统
DEBUG=true

# MySQL 8.4 LTS：先执行 scripts/init_db.sql 创建库和 study_app 账号
# 不要使用 root 运行应用；CHANGE_ME_APP_PASSWORD 换成你自己的密码
# 密码含 @ : / ? # 等字符时需 URL 编码，建议用 openssl rand -hex 16 生成
DATABASE_URL=mysql+pymysql://study_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:3306/smart_study_room?charset=utf8mb4

# 必须替换为一个足够长的随机字符串（≥32 字节，建议 openssl rand -hex 32）。
# 应用启动时会校验：仍为占位符或长度不足将拒绝启动（§2.1 不得绕过身份认证）。
JWT_SECRET_KEY=replace-with-a-long-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
