{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Paper Coordinates / 纸间座标",
    "version": "1.0.0",
    "description": "自习室座位预约模块的设计令牌。页面级主题，建议作用域 .seat-experience；不直接覆盖全站品牌令牌。",
    "date": "2026-11-06"
  },
  "color": {
    "light": {
      "paper": "#F3EFE5",
      "paper-2": "#ECE7DA",
      "surface": "#FFFCF5",
      "surface-2": "#FAF6EC",
      "surface-3": "#F3EDDF",
      "ink": "#1F241F",
      "ink-2": "#555D53",
      "ink-3": "#6B7268",
      "line": "#DFD8C8",
      "line-strong": "#C4BAA7",
      "brand": "#0E7164",
      "brand-hover": "#0A5C52",
      "brand-soft": "#DDEEE8",
      "brand-wash": "#EDF5F1",
      "amber": "#A8610A",
      "amber-ink": "#7A4504",
      "amber-soft": "#FBF0D9",
      "danger": "#B93A2B",
      "danger-ink": "#8E2A1F",
      "danger-soft": "#F9E6E1",
      "slate": "#5F665D",
      "slate-soft": "#ECE9DF",
      "focus": "#0E7164",
      "focus-halo": "rgba(14, 113, 100, 0.20)",
      "brand-halo": "rgba(14, 113, 100, 0.22)"
    },
    "dark": {
      "paper": "#151713",
      "paper-2": "#1C1F1A",
      "surface": "#20241E",
      "surface-2": "#262B24",
      "surface-3": "#2D322A",
      "ink": "#F3EFE3",
      "ink-2": "#C4C1B4",
      "ink-3": "#9B9A8C",
      "line": "#3A4036",
      "line-strong": "#50584B",
      "brand": "#68C7B7",
      "brand-hover": "#8AD8CA",
      "brand-soft": "#1B3D36",
      "brand-wash": "#1A2E29",
      "amber": "#F0B45A",
      "amber-ink": "#F6D39A",
      "amber-soft": "#3A2E19",
      "danger": "#F08A78",
      "danger-ink": "#FFC4B8",
      "danger-soft": "#3E2520",
      "slate": "#B8B5A8",
      "slate-soft": "#2D3129",
      "focus": "#F0B45A",
      "focus-halo": "rgba(240, 180, 90, 0.22)",
      "brand-halo": "rgba(104, 199, 183, 0.20)"
    },
    "material": {
      "wood-1": "#E4CFA9",
      "wood-2": "#C9AA78",
      "wood-3": "#A8854F",
      "wood-line": "#8F6F43",
      "table-top": "#E8D4AD",
      "table-mid": "#D8BB88",
      "table-edge": "#AD8959",
      "table-extrusion": "#A8854F",
      "table-label": "#493722",
      "table-label-muted": "#6C5437"
    }
  },
  "furniture": {
    "model": "table + chair",
    "tableCount": 10,
    "seatCount": 28,
    "shapes": ["rect", "capsule", "round"],
    "chairOrientations": ["n", "s", "e", "w"],
    "hitTarget": "chair only; table body never selects a seat",
    "tableHover": "table lightens; all chairs on the table get a subtle highlight",
    "chairHover": "only the hovered chair rises 1px",
    "selected": "chair ring + table edge glow + small check badge",
    "tableRadius": { "rect": "7px", "capsule": "999px", "round": "50%" },
    "chairRadius": "13px / 7px depending on orientation",
    "tableLabel": "label (W1, C2…) + property icons + seat count",
    "chairLabel": "seat number on chair pad; full ID in aria/tooltip"
  },
  "seatState": {
    "free": {
      "label": "空闲",
      "background": "#E7F3EE",
      "line": "#0E7164",
      "foreground": "#0A5C52",
      "icon": "none",
      "border": "solid",
      "meaning": "资源可用且该时段未被占用"
    },
    "taken": {
      "label": "已被预约",
      "background": "#F2EDE2",
      "line": "#B49A70",
      "foreground": "#6E5B3E",
      "icon": "clock",
      "border": "dashed, low-saturation",
      "meaning": "资源可用，但该时段已被他人预约；降饱和处理，减少满房时的视觉噪音"
    },
    "mine": {
      "label": "我的预约",
      "background": "#F5C86A",
      "line": "#8C5A00",
      "foreground": "#3F2A00",
      "icon": "check",
      "border": "double",
      "meaning": "资源可用且该时段属于当前用户"
    },
    "held": {
      "label": "临时保留",
      "background": "#E7E1D3",
      "line": "#8B7B5F",
      "foreground": "#5E5138",
      "icon": "hourglass",
      "border": "solid + diagonal hatch",
      "meaning": "管理员短时保留，到期自动释放"
    },
    "locked": {
      "label": "未开放/锁定",
      "background": "#EAE7DE",
      "line": "#6B7069",
      "foreground": "#4A514A",
      "icon": "lock",
      "border": "dotted",
      "meaning": "资源停用或区域锁定"
    },
    "fix": {
      "label": "维修中",
      "background": "#F7E4DF",
      "line": "#B93A2B",
      "foreground": "#8E2A1F",
      "icon": "wrench",
      "border": "solid + diagonal hatch",
      "meaning": "资源状态为维修中"
    }
  },
  "typography": {
    "families": {
      "display": "Fraunces, Noto Serif SC, Songti SC, STSong, serif",
      "ui": "Noto Sans SC, HarmonyOS Sans SC, PingFang SC, Microsoft YaHei, sans-serif",
      "mono": "IBM Plex Mono, SFMono-Regular, Consolas, monospace"
    },
    "scale": {
      "micro": "9px",
      "caption": "10px",
      "small": "11px",
      "body": "13px",
      "body-lg": "15px",
      "title-sm": "18px",
      "title": "22px",
      "display-sm": "28px",
      "display": "36px",
      "display-lg": "52px"
    },
    "lineHeight": {
      "tight": "1.1",
      "snug": "1.35",
      "body": "1.6",
      "loose": "1.75"
    },
    "letterSpacing": {
      "display": "-0.035em",
      "mono": "0.06em",
      "caps": "0.12em"
    },
    "note": "中文正文使用系统可读黑体，展示标题用宋体/衬线；生产环境应自托管 WOFF2 子集，不依赖 Google Fonts。"
  },
  "spacing": {
    "unit": "4px",
    "scale": ["4px", "8px", "12px", "16px", "20px", "24px", "32px", "40px", "56px", "72px"],
    "page": {
      "desktop": "30px 36px 94px",
      "mobile": "20px 12px 92px"
    },
    "map": {
      "coordinateUnit": "1cm",
      "grid": "10 units",
      "seatGap": "8 units",
      "aisleMin": "120 units"
    }
  },
  "radius": {
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "10px",
    "xl": "14px",
    "2xl": "18px",
    "3xl": "24px",
    "full": "999px"
  },
  "shadow": {
    "light": {
      "sm": "0 1px 0 rgba(62, 49, 29, 0.06)",
      "md": "0 14px 30px -20px rgba(62, 49, 29, 0.28)",
      "lg": "0 30px 70px -36px rgba(62, 49, 29, 0.36)"
    },
    "dark": {
      "sm": "0 1px 0 rgba(0, 0, 0, 0.18)",
      "md": "0 16px 34px -20px rgba(0, 0, 0, 0.55)",
      "lg": "0 30px 70px -30px rgba(0, 0, 0, 0.68)"
    },
    "rule": "浅色用暖褐色阴影，不用纯黑；深色禁用大阴影，层次优先用 1px 描边和底色差。"
  },
  "motion": {
    "duration": {
      "instant": "120ms",
      "fast": "140ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "rules": [
      "地图缩放/平移只改变 transform，不触发布局",
      "座位 hover 抬升 2px，按压回弹；不改宽高",
      "尊重 prefers-reduced-motion"
    ]
  },
  "map": {
    "roomUnit": { "width": 760, "height": 580 },
    "zoom": { "min": 0.5, "max": 2.5, "buttonStep": 1.2, "wheelFactor": 0.0016 },
    "labelScale": {
      "far": "0.62",
      "mid": "1.12",
      "fontClamp": "8px–18px in room units, counter-scaled"
    },
    "hitTarget": { "recommended": "44px CSS", "minimum": "24px CSS" },
    "rendererThresholds": {
      "dom": "<= 300",
      "canvas": "301–1000",
      "canvasTiles": "> 1000"
    },
    "performanceTargets": {
      "initialInteractiveMs": 1500,
      "panZoomFps": 55,
      "p95FrameMs": 18,
      "hitTestMs": 2,
      "memoryMB": 80
    }
  },
  "breakpoints": {
    "mobile": "390px",
    "tablet": "768px",
    "smallDesktop": "1024px",
    "desktop": "1280px",
    "wide": "1440px"
  }
}
